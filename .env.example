# ---------- Frontend (públicas, embutidas no bundle) ----------
# Este projeto usa só o Cloud Firestore (plano gratuito/Spark) — nenhum outro produto do
# Firebase (Auth, Storage, Functions, Analytics...) é necessário nem deve ser habilitado.
# Pegue em: Firebase Console > Configurações do projeto > Seus apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_PROJECT_ID=seu-projeto

# ---------- Backend / funções serverless (privadas, só na Vercel) ----------
# Mesmo projectId do Firebase acima — usado pelas funções em /api para falar
# com a REST API do Firestore (sem precisar de API key, pois as regras são abertas).
FIREBASE_PROJECT_ID=seu-projeto

# Token privado do Mercado Pago (Suas integrações > (sua aplicação) > Credenciais de produção)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Chave secreta do webhook (Suas integrações > (sua aplicação) > Webhooks > Configurar notificações)
# Sem essa variável a verificação de assinatura fica desativada (webhook aceita qualquer chamada).
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Login da Pastoral (painel /pastoral) ----------
# Verificado no navegador. ATENÇÃO: por serem VITE_*, estes valores são embutidos no bundle e
# ficam legíveis por qualquer visitante — servem para configurar o acesso sem editar código,
# não para guardar segredo (as regras do Firestore já são abertas nesta fase).
VITE_ADMIN_USUARIO=dizimo

# Recomendado: informe o HASH da senha (a senha em si não aparece no bundle).
# Gere com: npm run gerar:hash-senha -- "sua-senha"
VITE_ADMIN_SENHA_HASH=

# Alternativa mais simples, porém a senha fica visível no bundle.
# Só é usada quando VITE_ADMIN_SENHA_HASH está vazio.
VITE_ADMIN_SENHA=
